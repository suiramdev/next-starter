# Base URL for the Better Auth service
# This URL is exposed to the client (NEXT_PUBLIC_ prefix)
# Default: http://localhost:3002
# Update to match your auth service deployment URL
NEXT_PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:3002

# Comma-separated list of allowed origins for CORS
# Controls which domains can access your API endpoints
# Examples:
# - Single origin: "https://example.com"
# - Multiple origins: "https://app.example.com,https://admin.example.com"
# - Development: "http://localhost:3000,http://localhost:3001"
# - Use "*" to allow all origins (not recommended for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Zero Database Configuration
# Connection string to the upstream PostgreSQL database that Zero syncs from
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# This is the source database that Zero will replicate to the local SQLite replica
ZERO_UPSTREAM_DB="postgresql://postgres:postgres@localhost:5432/postgres"

# Zero Replica File Path
# Local file path where Zero stores the SQLite replica database
# This file is automatically created and managed by Zero
# Default: /tmp/sync-replica.db
# Note: This file is gitignored and should not be committed
ZERO_REPLICA_FILE="/tmp/sync-replica.db"

# Zero Server URL
# The URL of the Zero server instance (used by the zero-cache-dev command)
# This URL is exposed to the client (NEXT_PUBLIC_ prefix)
# Default: http://localhost:4848
# Update this if your Zero server is running on a different host/port
NEXT_PUBLIC_ZERO_SERVER="http://localhost:4848"

# Zero Secret Key
# Secret key used by Zero cache server to verify JWT tokens
# Generate with: openssl rand -base64 32
ZERO_AUTH_SECRET=secret
