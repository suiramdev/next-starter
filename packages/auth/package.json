{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./helpers/next-js/*": "./src/helpers/next-js/*.ts",
    "./helpers/react/*": "./src/helpers/react/*.ts",
    "./helpers/react/components/forms/*": "./src/helpers/react/components/forms/*.tsx",
    "./helpers/zero/*": "./src/helpers/zero/*.ts"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome format --write",
    "auth:generate": "npx @better-auth/cli generate --config ./src/server.ts --output ../db/src/schema/auth.prisma -y"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@repo/zero": "workspace:^",
    "@repo/db": "workspace:^",
    "@repo/ui": "workspace:^",
    "better-auth": "^1.3.34",
    "jose": "^5.10.0",
    "next": "^16.0.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.34",
    "@biomejs/biome": "^2.3.2",
    "@repo/biome-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/react": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
